# Set to production only after every secret below is injected by your host.
SATQUERY_ENVIRONMENT=development

# Firebase Admin service-account JSON. Store this as a deployment secret,
# never commit it. A path is also supported for local development.
SATQUERY_FIREBASE_PROJECT_ID=
SATQUERY_FIREBASE_CREDENTIALS=

# PostgreSQL: users, workspaces, roles, chats, audit logs, projects.
SATQUERY_DATABASE_URL=

# S3-compatible storage. For AWS S3 leave ENDPOINT_URL empty. For Cloudflare
# R2 use https://<account-id>.r2.cloudflarestorage.com.
SATQUERY_OBJECT_STORAGE_BUCKET=
SATQUERY_OBJECT_STORAGE_PREFIX=satquery
SATQUERY_OBJECT_STORAGE_REGION=auto
SATQUERY_OBJECT_STORAGE_ENDPOINT_URL=
SATQUERY_OBJECT_STORAGE_ACCESS_KEY_ID=
SATQUERY_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# VLM Backend: "groq" for low-latency Cloud LLM/Vision (recommended), "mlx" on Apple Silicon, "local" on CUDA, or "mock"
SATQUERY_VLM_BACKEND=groq

# Groq API key (starts with gsk_). Required if SATQUERY_VLM_BACKEND=groq.
SATQUERY_GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model overrides:
# SATQUERY_GROQ_MODEL=llama-3.2-11b-vision-preview
# SATQUERY_GROQ_TEXT_MODEL=llama-3.3-70b-versatile

